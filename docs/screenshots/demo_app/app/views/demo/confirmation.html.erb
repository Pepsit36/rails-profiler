<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= @title %></title>
  <style>
    body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; background: #f4f5f7; color: #222; }
    header { background: #1f2937; color: #fff; padding: 18px 40px; font-size: 20px; font-weight: 600; }
    main { padding: 32px 40px; max-width: 1100px; }
    .card { background: #fff; border-radius: 8px; padding: 20px 24px; box-shadow: 0 1px 3px rgba(0,0,0,.08); font-size: 15px; line-height: 1.7; }
    .card b { font-size: 22px; display: block; margin-bottom: 8px; }
  </style>
</head>
<body>
  <header><%= @title %></header>
  <main>
    <div class="card">
      <b>Order #4211 confirmed</b>
      Payment of €42.00 received from Jane Example. A confirmation mail is on its way, and the
      invoice will be generated with tonight's daily report.
    </div>
  </main>
</body>
</html>
