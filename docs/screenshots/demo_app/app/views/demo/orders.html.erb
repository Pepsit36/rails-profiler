<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= @title %></title>
  <style>
    body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; background: #f4f5f7; color: #222; }
    header { background: #1f2937; color: #fff; padding: 18px 40px; font-size: 20px; font-weight: 600; }
    main { padding: 32px 40px; max-width: 1100px; }
    .cards { display: flex; gap: 16px; margin-bottom: 24px; }
    .card { background: #fff; border-radius: 8px; padding: 16px 20px; flex: 1; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .card b { display: block; font-size: 24px; margin-top: 4px; }
    table { width: 100%; background: #fff; border-collapse: collapse; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    th, td { text-align: left; padding: 10px 16px; border-bottom: 1px solid #eee; font-size: 14px; }
  </style>
</head>
<body>
  <header><%= @title %></header>
  <main>
    <div class="cards">
      <div class="card">Orders this month<b><%= @totals[:count] %></b></div>
      <div class="card">Revenue<b><%= number_to_currency(@totals[:revenue], unit: "€") %></b></div>
      <div class="card">Customers<b><%= @customers.size %></b></div>
    </div>
    <h2><%= @heading %></h2>
    <table>
      <tr><th>Order</th><th>Customer</th><th>Item</th><th>Seller</th></tr>
      <% @posts.each_with_index do |post, i| %>
        <%= render "order_row", post: post, index: i, customers: @customers %>
      <% end %>
    </table>
  </main>
  <script>
    // AJAX sub-requests of this page, linked to it by the profiler's interceptor.
    window.addEventListener('load', () => {
      fetch('/api/users').then(() => fetch('/api/n_plus_one')).then(() => fetch('/api/slow_query'))
    })
  </script>
</body>
</html>
