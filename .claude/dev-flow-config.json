{
  "global": {
    "forge": "gitlab",
    "host": "git.duplessy.eu",
    "repos": [
      {
        "name": "rails-profiler-gem",
        "path": ".",
        "issues": true
      }
    ],
    "default_branch": "master",
    "enabled_skills": ["dev", "ship"]
  },
  "plugins": {
    "dev": {
      "auto_check_issues": false,
      "doc_update": {
        "enabled": false
      },
      "investigate_resources": ["Code source"],
      "check_commands": [
        "CI=1 bundle exec rspec",
        "rubocop"
      ]
    },
    "ship": {
      "merge_behavior": "never",
      "fresh_from_default_branch": "no",
      "use_worktree": "no"
    }
  }
}
