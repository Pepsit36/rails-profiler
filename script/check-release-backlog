#!/usr/bin/env bash
#
# Fails while a version stamped in master's CHANGELOG.md has no git tag: a release that
# did not complete. Merging more on top would stack unpublished versions. Decided from
# the CHANGELOG and the tags only, no API and no token.
#
# Exempt: the branches named fix/release-*, which are the ones that repair it.

set -euo pipefail

branch="${CI_COMMIT_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}"
case "$branch" in
  fix/release-*)
    echo "Branch ${branch} repairs the release pipeline: the backlog check is skipped."
    exit 0
    ;;
esac

git fetch --quiet --tags origin "+refs/heads/master:refs/remotes/origin/master"

missing="$(git show origin/master:CHANGELOG.md | ruby -e '
  Encoding.default_external = Encoding.find("UTF-8")
  sections = STDIN.read.scan(/^##\s*\[(\d+\.\d+\.\d+)\][^\n]*\n(.*?)(?=^##\s|\z)/m)
  sections.each do |version, body|
    next unless body.include?("<!-- stamped -->")
    next if system("git", "rev-parse", "--verify", "--quiet", "refs/tags/v#{version}",
                   out: File::NULL, err: File::NULL)

    puts version
  end
')"

[ -z "$missing" ] && { echo "Every stamped version of master has its tag."; exit 0; }

{
  echo "ERROR: master has a version that was never published: $(echo "$missing" | paste -sd, - | sed 's/,/, /g')"
  echo
  echo "CHANGELOG.md on master stamps it, but no git tag v<version> exists. The release job of"
  echo "the merge that brought it failed or never ran, so the version is not on RubyGems."
  echo "This branch is blocked so that nothing piles up on top of an unpublished version."
  echo
  echo "What to do:"
  echo "  1. open the pipeline of the master commit that stamped it, and read the failed"
  echo "     \`release\` job;"
  echo "  2. fix the cause (a token, a registry, the right to push a tag) and retry that job:"
  echo "     it tags the commit and publishes;"
  echo "  3. retry this job. If the release job is only still running, wait for it."
  echo
  echo "A fix to the release itself goes on a branch named fix/release-<something>: that"
  echo "prefix is exempt from this check."
} >&2
exit 1
