<!DOCTYPE html>
<html>
  <head>
    <title>Rails Profiler</title>
    <link rel="icon" type="image/png" href="/_profiler/assets/icon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="profiler-version" content="<%= Profiler.version %>">
    <meta name="profiler-name" content="<%= Profiler.configuration.resolved_name %>">
    <meta name="profiler-is-master" content="<%= Profiler.configuration.master? %>">

    <link rel="stylesheet" href="<%= Profiler::Assets.url("profiler.css") %>">
    <script src="<%= Profiler::Assets.url("profiler.js") %>" defer></script>
  </head>

  <body>
    <div id="profiler-cluster-selector"></div>
    <%= yield %>
  </body>
</html>
