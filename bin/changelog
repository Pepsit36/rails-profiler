#!/usr/bin/env ruby
# frozen_string_literal: true

# Single changelog generator for this gem.
#
# Pure Ruby, standard library only, no extra gem: the `release` CI job runs it
# from a plain `ruby:3.3` image, before (and independently of) `bundle install`.
#
# This is the only implementation of the "commit subjects to Keep a Changelog"
# mapping. Both the reconstructed history and the per release stamping done by
# CI go through it.
#
#   bin/changelog history                     rebuild CHANGELOG.md from every git tag
#   bin/changelog unreleased [--since REF]    print the entry body for commits since REF
#   bin/changelog release --version X.Y.Z     stamp [Unreleased] as a released section
#   bin/changelog check [--base REF]          fail when releasable commits leave
#                                             [Unreleased] untouched
#   bin/changelog coverage                    fail when a commit of a tag interval is
#                                             neither described nor explicitly excluded
#
# Version numbers are never computed here: the `release` job owns that, from the
# last tag and the conventional commit types, and passes the result in.

require "date"

CHANGELOG_FILE = "CHANGELOG.md"
UNRELEASED_HEADING = "## [Unreleased]"
NO_CHANGES = "_No notable changes._"

# Keep a Changelog section order.
SECTION_ORDER = ["Added", "Changed", "Removed", "Fixed", "Security"].freeze

# Conventional commit type to Keep a Changelog section.
TYPE_SECTIONS = {
  "feat" => "Added",
  "fix" => "Fixed",
  "perf" => "Changed",
  "refactor" => "Changed",
  "docs" => "Changed",
  "build" => "Changed",
  "deps" => "Changed",
  "revert" => "Removed",
  "security" => "Security"
}.freeze

# Types that never produce a changelog entry.
SKIPPED_TYPES = %w[chore ci test style].freeze

# Why a commit is absent from the changelog, by type. Written into the
# `excluded:` block of a section so that the coverage check has a reason to
# read, and the reader of a diff has one too.
# Keyed by type, or by "type(scope)" when the scope changes the reason.
EXCLUSION_REASONS = {
  "ci" => "pipeline only",
  "chore(ci)" => "pipeline only",
  "chore(release)" => "release plumbing",
  "test" => "tests only",
  "style" => "formatting only, no visible change",
  "chore" => "housekeeping, not user visible"
}.freeze
DEFAULT_EXCLUSION_REASON = "not a user visible change"

# Readable names for the scopes this project uses, so that a bullet reads like a
# sentence written by a person. Anything absent falls back to the scope itself
# with its dashes turned into spaces and its first letter capitalised.
SCOPE_NAMES = {
  "api" => "API",
  "ci" => "CI",
  "cors" => "CORS",
  "env" => "Env vars",
  "env-vars" => "Env vars",
  "gem" => "Packaging",
  "gemspec" => "Packaging",
  "http" => "HTTP",
  "i18n" => "I18n",
  "mcp" => "MCP",
  "sse" => "SSE",
  "sql" => "SQL",
  "ui" => "UI",
  "url" => "URL"
}.freeze

CONVENTIONAL_SUBJECT = /\A(?<type>[a-z]+)(?:\((?<scope>[^)]*)\))?(?<bang>!)?:\s+(?<desc>.+)\z/

# Same rule as the `release` job, applied to subjects and bodies alike:
#   grep -qE "^BREAKING CHANGE:|^[a-z]+(\(.+\))?!:"
#   grep -qE "^feat(\(.+\))?:"
#   grep -qE "^fix(\(.+\))?:"
RELEASABLE_LINE = /^(?:BREAKING CHANGE:|[a-z]+(?:\(.+\))?!:|feat(?:\(.+\))?:|fix(?:\(.+\))?:)/

# The release commit of a version belongs to the interval of its own tag, since
# the tag is placed on it, and the job that writes it cannot cite its own sha
# while stamping. It is therefore recognised by its subject alone, narrowly:
# the version in the subject has to be the version of the section it sits in.
# Both wordings this repository has used are accepted.
def release_commit_subject?(subject, version)
  subject.strip.match?(
    /\Achore\(release\): (?:bump version to )?v#{Regexp.escape(version)}(?: \[skip ci\])?\z/
  )
end

HEADER = <<~MD
  # Changelog

  All notable changes to this project are documented in this file.

  The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),
  and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).

  Released sections are written by the `release` CI job, which derives the version
  from the last tag and the conventional commit types, stamps the `[Unreleased]`
  section below and commits the result as `chore(release): vX.Y.Z [skip ci]`.
  Add your own entries under `[Unreleased]`; do not edit released sections.

  Each bullet carries the short sha of the commit it describes, in an HTML comment
  that stays invisible once rendered. Commits deliberately absent from a version are
  listed in that version's `excluded:` comment with the reason. `bin/changelog
  coverage` checks that every commit of every tag interval is in one or the other.
MD

Commit = Struct.new(:sha, :subject, :body)

module Git
  module_function

  # nil instead of an exception when git fails: every caller has a sane
  # fallback (a missing file, an unknown ref, a repository without tags).
  def try(*args)
    out = IO.popen(["git", *args], err: File::NULL, &:read)
    $?.success? ? out : nil
  end

  def commits(range, merges: false)
    args = ["log", "--format=%H%x1f%s%x1f%b%x1e"]
    args << "--no-merges" unless merges
    args << range unless range.nil? || range.to_s.empty?
    (try(*args) || "").split("\x1e").filter_map do |record|
      record = record.sub(/\A\n+/, "")
      next if record.empty?

      sha, subject, body = record.split("\x1f", 3)
      Commit.new(sha.to_s.strip, subject.to_s, body.to_s)
    end
  end

  def tags
    (try("tag", "--sort=v:refname") || "").split("\n").map(&:strip).reject(&:empty?)
  end

  # Tags reachable from HEAD only. A branch pipeline fetches master to compare
  # against it, and git follows the tags of what it downloads, so a clone of a
  # branch can hold tags published after that branch was cut. Those versions
  # have no section in this branch's file, and should not be asked for one.
  def tags_merged_into_head
    (try("tag", "--sort=v:refname", "--merged", "HEAD") || "")
      .split("\n").map(&:strip).reject(&:empty?)
  end

  def tagged_commit_date(tag)
    (try("log", "-1", "--format=%cs", "#{tag}^{commit}") || "").strip
  end

  def last_tag
    (try("describe", "--tags", "--abbrev=0") || "").strip
  end
end

# Maps a commit range to Keep a Changelog sections.
module Entries
  module_function

  def sections(range)
    result = {}
    Git.commits(range).each do |commit|
      bullet = bullet_for(commit)
      next if bullet.nil?

      (result[bullet[:section]] ||= []) << bullet[:text]
    end
    result.each_value(&:uniq!)
    result
  end

  def bullet_for(commit)
    match = CONVENTIONAL_SUBJECT.match(commit.subject.strip)
    return nil if match.nil?

    breaking = breaking?(commit, match)
    # A breaking change publishes a major version whatever its type, so it has
    # to be listed even when that type is normally skipped. Keep a Changelog has
    # no section for it, and a breaking change is a change, so: Changed.
    return nil if !breaking && SKIPPED_TYPES.include?(match[:type])

    section = breaking ? "Changed" : TYPE_SECTIONS[match[:type]]
    return nil if section.nil?

    description = sentence(match[:desc])
    scope = pretty_scope(match[:scope])
    text = scope.nil? ? description : "**#{scope}:** #{description}"
    text = "**Breaking:** #{text}" if breaking

    { section: section, text: "- #{text} <!-- #{commit.sha[0, 7]} -->" }
  end

  # Full sentence, capitalised, without a trailing period: the style of the
  # changelog Sebastien wrote by hand.
  def sentence(description)
    text = description.to_s.strip.sub(/\.\z/, "")
    return text if text.empty?

    text.sub(/\A(.)/) { Regexp.last_match(1).upcase }
  end

  def pretty_scope(scope)
    scope = scope.to_s.strip
    return nil if scope.empty?
    return SCOPE_NAMES[scope] if SCOPE_NAMES.key?(scope)

    scope.tr("-", " ").sub(/\A(.)/) { Regexp.last_match(1).upcase }
  end

  # Commits of a range that produce no bullet, with the reason why.
  def exclusions(range, version)
    Git.commits(range).filter_map do |commit|
      next if bullet_for(commit)
      next if release_commit_subject?(commit.subject, version)

      match = CONVENTIONAL_SUBJECT.match(commit.subject.strip)
      reason = if match.nil?
                 "subject is not conventional"
               else
                 scoped = "#{match[:type]}(#{match[:scope]})"
                 EXCLUSION_REASONS[scoped] ||
                   EXCLUSION_REASONS.fetch(match[:type], DEFAULT_EXCLUSION_REASON)
               end
      [commit.sha[0, 7], reason]
    end
  end

  def exclusions_block(range, version)
    entries = exclusions(range, version)
    return nil if entries.empty?

    lines = entries.map { |sha, reason| "  #{sha} #{reason}" }
    "<!-- excluded:\n#{lines.join("\n")}\n-->\n"
  end

  # The HTML comments that make a section complete for `coverage`.
  #
  # `covered: true` is for a section whose text was written by hand: nobody can
  # tell which bullet describes which commit, so every publishable commit of the
  # interval is listed at the section level. The others are listed as exclusions
  # with their reason. Together they account for every non-merge commit of the
  # interval except its release commit, which is matched by its subject.
  def coverage_comments(range, version, covered:)
    out = +""

    if covered
      shas = Git.commits(range).filter_map { |commit| commit.sha[0, 7] if bullet_for(commit) }
      out << "<!-- covered: #{shas.join(" ")} -->\n" unless shas.empty?
    end

    block = exclusions_block(range, version)
    out << block unless block.nil?
    out
  end

  def breaking?(commit, match)
    !match[:bang].nil? || commit.body.to_s.match?(/^BREAKING CHANGE:/)
  end

  # Entry body for a range, or nil when the range holds nothing worth listing.
  def body(range)
    found = sections(range)
    blocks = SECTION_ORDER.filter_map do |name|
      bullets = found[name]
      next if bullets.nil? || bullets.empty?

      "### #{name}\n\n#{bullets.join("\n")}\n"
    end
    blocks.empty? ? nil : blocks.join("\n")
  end

  def releasable?(commit)
    "#{commit.subject}\n#{commit.body}".match?(RELEASABLE_LINE)
  end
end

# Reads and rewrites the sections of a CHANGELOG.md.
module Sections
  module_function

  def split(text)
    text.to_s.split("\n", -1)
  end

  def unreleased_index(lines)
    lines.index { |line| line =~ /\A##\s*\[unreleased\]/i }
  end

  def first_version_index(lines)
    lines.index { |line| line =~ /\A##\s*\[/ }
  end

  # Index of the heading that closes the section opened at `from`.
  def section_end(lines, from)
    offset = lines[(from + 1)..].to_a.index { |line| line =~ /\A##\s/ }
    offset.nil? ? lines.length : from + 1 + offset
  end

  # Text of the `## [version]` section, heading excluded, or nil when absent.
  def version_body(lines, version)
    index = lines.index { |line| line =~ /\A##\s*\[#{Regexp.escape(version)}\]/ }
    return nil if index.nil?

    lines[(index + 1)...section_end(lines, index)].join("\n")
  end

  def unreleased_body(lines)
    index = unreleased_index(lines)
    return nil if index.nil?

    lines[(index + 1)...section_end(lines, index)].join("\n")
  end
end

# Reads the commit references CHANGELOG.md carries in HTML comments, and checks
# every tag interval against them.
#
# Three forms, all invisible once rendered:
#
#   - **UI:** Always show the waterfall <!-- 32c6b6d -->
#   <!-- covered: 5afd003 aef4c0c -->
#   <!-- excluded:
#     3ba06d1 release plumbing written by CI
#     e27cdae pipeline only
#   -->
#
# They live in CHANGELOG.md rather than in a file of their own on purpose: a
# reference then travels with the text it belongs to, and the release job, which
# is only ever allowed to commit CHANGELOG.md, can keep them up to date.
module Coverage
  module_function

  COMMENT = /<!--(.*?)-->/m
  SHA = /\A[0-9a-f]{7,40}\z/

  Refs = Struct.new(:referenced, :excluded, :malformed)

  def parse(section)
    referenced = []
    excluded = {}
    malformed = []

    section.to_s.scan(COMMENT).each do |(body)|
      lines = body.to_s.strip.lines.map(&:strip).reject(&:empty?)
      next if lines.empty?

      kind, lines = kind_of(lines)
      case kind
      when :excluded
        lines.each do |line|
          sha, reason = line.split(/\s+/, 2)
          if sha.to_s.match?(SHA) && !reason.to_s.strip.empty?
            excluded[sha] = reason.strip
          else
            malformed << line
          end
        end
      else
        lines.join(" ").split(/\s+/).each do |token|
          token.match?(SHA) ? referenced << token : malformed << token
        end
      end
    end

    Refs.new(referenced.uniq, excluded, malformed.uniq)
  end

  # Strips a leading `excluded:` or `covered:` marker and says which it was.
  def kind_of(lines)
    first = lines.first
    if first.start_with?("excluded:")
      [:excluded, [first.sub("excluded:", "").strip, *lines.drop(1)].reject(&:empty?)]
    elsif first.start_with?("covered:")
      [:covered, [first.sub("covered:", "").strip, *lines.drop(1)].reject(&:empty?)]
    else
      [:covered, lines]
    end
  end

  def resolve(sha)
    out = Git.try("rev-parse", "--verify", "--quiet", "#{sha}^{commit}")
    out.to_s.strip.empty? ? nil : out.strip
  end
end

module Commands
  module_function

  def history(_options)
    out = +HEADER
    out << "\n#{UNRELEASED_HEADING}\n"

    tags = Git.tags
    head_body = tags.empty? ? Entries.body(nil) : Entries.body("#{tags.last}..HEAD")
    out << "\n#{head_body}" unless head_body.nil?

    previous = nil
    released = tags.map do |tag|
      range = previous.nil? ? tag : "#{previous}..#{tag}"
      previous = tag
      version = tag.sub(/\Av/, "")
      body = Entries.body(range) || "#{NO_CHANGES}\n"
      comments = Entries.coverage_comments(range, version, covered: false)
      [version, Git.tagged_commit_date(tag), comments.empty? ? body : "#{body}\n#{comments}"]
    end

    released.reverse_each do |version, date, body|
      out << "\n## [#{version}] - #{date}\n\n#{body}"
    end

    print out
    0
  end

  def unreleased(options)
    body = Entries.body(range_for(options))
    print(body || "#{NO_CHANGES}\n")
    0
  end

  def release(options)
    version = options[:version]
    abort "bin/changelog release: --version X.Y.Z is required" if version.to_s.empty?

    date = options[:date] || Date.today.to_s
    file = options[:file] || CHANGELOG_FILE
    range = range_for(options)

    unless File.exist?(file)
      puts "#{file} does not exist, creating it."
      File.write(file, "#{HEADER}\n#{UNRELEASED_HEADING}\n")
    end

    lines = Sections.split(File.read(file))
    index = Sections.unreleased_index(lines)

    if index.nil?
      lines = stamp_without_unreleased(lines, version, date, range, file)
    else
      lines = stamp_unreleased(lines, index, version, date, range)
    end

    File.write(file, lines.join("\n"))
    puts "Stamped #{file}: [Unreleased] is now [#{version}] - #{date}, a fresh empty [Unreleased] is open above it."
    0
  end

  # [Unreleased] exists: rename its heading, reopen an empty one above, and fall
  # back to the commit subjects when the section was left empty.
  def stamp_unreleased(lines, index, version, date, range)
    stop = Sections.section_end(lines, index)
    body = lines[(index + 1)...stop].join("\n")

    if body.strip.empty?
      body = Entries.body(range) || "#{NO_CHANGES}\n"
      puts "The [Unreleased] section was empty: generating the #{version} entry from the commit subjects of #{range_label(range)}."
      puts "--- generated entry ---"
      puts body
      puts "--- end of generated entry ---"
      # The generated bullets already carry their own sha, so only the
      # exclusions are missing.
      comments = Entries.coverage_comments(range, version, covered: false)
    else
      puts "Reusing the #{body.strip.lines.count} line(s) already written under [Unreleased]."
      body = "#{body.strip}\n"
      comments = Entries.coverage_comments(range, version, covered: true)
    end

    unless comments.empty?
      puts "Commit references written into the #{version} section, so that `bin/changelog coverage` stays true:"
      puts comments
    end

    lines[index...stop] = section_lines(version, date, body, comments)
    lines
  end

  # `## [Unreleased]`, then the released section, then one blank line before
  # whatever followed.
  def section_lines(version, date, body, comments)
    text = comments.empty? ? body : "#{body}\n#{comments}"
    [UNRELEASED_HEADING, "", "## [#{version}] - #{date}", "", *Sections.split(text.sub(/\n+\z/, "\n"))]
  end

  # No [Unreleased] section at all: defined behaviour, documented and tested.
  # Do not fail the release; insert a fresh empty [Unreleased] plus a generated
  # section for this version, right after the preamble.
  def stamp_without_unreleased(lines, version, date, range, file)
    generated = Entries.body(range) || "#{NO_CHANGES}\n"
    puts "WARNING: #{file} has no [Unreleased] section."
    puts "Inserting one, and generating the #{version} entry from the commit subjects of #{range_label(range)}."
    puts "--- generated entry ---"
    puts generated
    puts "--- end of generated entry ---"

    comments = Entries.coverage_comments(range, version, covered: false)
    insert_at = Sections.first_version_index(lines) || lines.length
    block = section_lines(version, date, generated, comments)
    block << "" if insert_at == lines.length
    lines[insert_at, 0] = block
    lines
  end

  def check(options)
    base = options[:base] || "origin/master"
    file = options[:file] || CHANGELOG_FILE

    merge_base = (Git.try("merge-base", base, "HEAD") || "").strip
    if merge_base.empty?
      warn "changelog check: no merge base between #{base} and HEAD."
      warn "Fetch it first (git fetch origin #{base.sub(%r{\Aorigin/}, "")}) and make sure the clone is not shallow (GIT_DEPTH: \"0\")."
      return 1
    end

    offenders = Git.commits("#{merge_base}..HEAD", merges: true).select { |commit| Entries.releasable?(commit) }
    if offenders.empty?
      puts "changelog check: no releasable commit between #{merge_base[0, 8]} and HEAD, nothing to require."
      return 0
    end

    before = Sections.unreleased_body(Sections.split(Git.try("show", "#{merge_base}:#{file}") || "")).to_s.strip
    after = Sections.unreleased_body(Sections.split(File.exist?(file) ? File.read(file) : "")).to_s.strip

    if before == after
      warn "changelog check: FAILED."
      warn ""
      warn "These commits would be published by the `release` job:"
      offenders.each { |commit| warn "  #{commit.sha[0, 8]} #{commit.subject}" }
      warn ""
      warn "but the [Unreleased] section of #{file} is unchanged since the merge base #{merge_base[0, 8]}."
      warn "Describe the change under `## [Unreleased]` (### Added / ### Changed / ### Removed /"
      warn "### Fixed / ### Security) and push again. `bin/changelog unreleased` prints a starting point."
      return 1
    end

    puts "changelog check: OK, #{offenders.count} releasable commit(s) and the [Unreleased] section of #{file} was updated."
    0
  end

  # Every non-merge commit of every tag interval has to be either described in
  # the section of its version or listed as an explicit exclusion with a reason.
  # [Unreleased] is out of scope: nothing is tagged there yet, and a commit
  # cannot cite its own sha while it is being written.
  def coverage(options)
    file = options[:file] || CHANGELOG_FILE
    unless File.exist?(file)
      warn "changelog coverage: #{file} not found."
      return 1
    end

    tags = Git.tags_merged_into_head
    if tags.empty?
      warn "changelog coverage: no tag reachable from HEAD in this repository."
      warn "This check walks every tag interval, so it has nothing to compare and refuses to"
      warn "pass silently. Fetch the tags first: GIT_DEPTH: \"0\" in CI, `git fetch --tags`"
      warn "locally. A shallow clone without tags is the usual cause."
      return 1
    end

    lines = Sections.split(File.read(file))
    problems = []
    checked = 0
    previous = nil

    tags.each do |tag|
      range = previous.nil? ? tag : "#{previous}..#{tag}"
      previous = tag
      version = tag.sub(/\Av/, "")
      body = Sections.version_body(lines, version)

      if body.nil?
        problems << ["#{version}", ["no `## [#{version}]` section in #{file}"]]
        next
      end

      found = check_interval(version, range, body)
      checked += found[:commits]
      problems << [version, found[:problems]] unless found[:problems].empty?
    end

    if problems.empty?
      puts "changelog coverage: OK, #{checked} commit(s) over #{tags.size} tag interval(s) are " \
           "each described in their version or explicitly excluded."
      return 0
    end

    warn "changelog coverage: FAILED."
    warn ""
    problems.each do |version, messages|
      warn "## [#{version}]"
      messages.each { |message| warn "  #{message}" }
      warn ""
    end
    warn "Describe each commit in the section of its version and reference it with an HTML"
    warn "comment at the end of its bullet (`<!-- abc1234 -->`), or list it in that section's"
    warn "`<!-- excluded: ... -->` block with a reason."
    1
  end

  def check_interval(version, range, body)
    refs = Coverage.parse(body)
    commits = Git.commits(range)
    in_interval = commits.to_h { |commit| [commit.sha, commit.subject] }
    problems = []

    refs.malformed.each do |token|
      problems << "malformed reference #{token.inspect}: expected a short sha, " \
                  "or `<sha> <reason>` inside an excluded block"
    end

    cited = {}
    (refs.referenced + refs.excluded.keys).each do |sha|
      full = Coverage.resolve(sha)
      if full.nil?
        problems << "#{sha} is referenced but is not a commit of this repository"
      elsif !in_interval.key?(full)
        problems << "#{sha} is referenced here but does not belong to #{range}"
      else
        cited[full] = sha
      end
    end

    excluded_full = refs.excluded.keys.filter_map { |sha| Coverage.resolve(sha) }

    commits.each do |commit|
      next if cited.key?(commit.sha) && !excluded_full.include?(commit.sha)
      next if excluded_full.include?(commit.sha)
      next if release_commit_subject?(commit.subject, version)

      problems << "#{commit.sha[0, 7]} #{commit.subject} is neither described nor excluded"
    end

    { problems: problems, commits: commits.size }
  end

  def range_for(options)
    since = options[:since].to_s
    since = Git.last_tag if since.empty?
    since.empty? ? nil : "#{since}..HEAD"
  end

  def range_label(range)
    range.nil? ? "the whole history" : range
  end
end

def parse_options(argv)
  options = {}
  until argv.empty?
    flag = argv.shift
    case flag
    when "--version" then options[:version] = argv.shift
    when "--date" then options[:date] = argv.shift
    when "--file" then options[:file] = argv.shift
    when "--since" then options[:since] = argv.shift
    when "--base" then options[:base] = argv.shift
    else abort "bin/changelog: unknown option #{flag}"
    end
  end
  options
end

def main(argv)
  command = argv.shift
  case command
  when "history" then Commands.history(parse_options(argv))
  when "unreleased" then Commands.unreleased(parse_options(argv))
  when "release" then Commands.release(parse_options(argv))
  when "check" then Commands.check(parse_options(argv))
  when "coverage" then Commands.coverage(parse_options(argv))
  when nil, "-h", "--help", "help"
    doc = File.read(__FILE__).lines.drop(3).take_while { |line| line.start_with?("#") }
    puts doc.map { |line| line.sub(/\A# ?/, "") }.join
    0
  else
    warn "bin/changelog: unknown command #{command}"
    1
  end
end

exit main(ARGV) if $PROGRAM_NAME == __FILE__
