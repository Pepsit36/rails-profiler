{
  "name": "rails-profiler-gem",
  "private": true,
  "scripts": {
    "build": "yarn build:js && yarn build:toolbar && yarn build:css",
    "build:full": "yarn codegen && yarn build",
    "build:js": "esbuild --minify app/assets/typescript/profiler/main.tsx --bundle --outfile=app/assets/builds/profiler.js --jsx=automatic --jsx-import-source=preact --format=iife --target=es2020 --alias:@tanstack/react-query=@tanstack/preact-query",
    "build:toolbar": "esbuild --minify app/assets/typescript/profiler/toolbar-bundle.tsx --bundle --outfile=app/assets/builds/profiler-toolbar.js --jsx=automatic --jsx-import-source=preact --format=iife --target=es2020 --alias:@tanstack/react-query=@tanstack/preact-query",
    "build:css": "sass app/assets/stylesheets/profiler/main.scss app/assets/builds/profiler.css --no-source-map --style=compressed",
    "codegen": "orval",
    "watch": "esbuild app/assets/typescript/profiler/main.tsx --bundle --outfile=app/assets/builds/profiler.js --jsx=automatic --jsx-import-source=preact --format=iife --target=es2020 --alias:@tanstack/react-query=@tanstack/preact-query --watch",
    "test": "yarn codegen && vitest run",
    "test:coverage": "yarn codegen && vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/preact-query": "^5.0.0",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "jsdom": "^26",
    "orval": "^8.41.0",
    "sass": "^1.85.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "picomatch": "^4.0.4"
  }
}
